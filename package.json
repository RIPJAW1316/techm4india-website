{
  "name": "techm4india-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-db.mjs && concurrently -k -n api,web -c magenta,cyan --handle-input \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vinext dev",
    "dev:api": "npm --prefix backend run start:dev",
    "dev:db": "node scripts/dev-db.mjs",
    "build": "vinext build",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/erp-shell.test.mjs tests/division-routing.test.mjs tests/api-client.test.mjs tests/institutions-ui.test.mjs tests/admin-users-ui.test.mjs tests/payroll-ui.test.mjs tests/finance-ui.test.mjs tests/recruitment-ui.test.mjs tests/programs-ui.test.mjs tests/performance-ui.test.mjs tests/supply-chain-ui.test.mjs tests/support-ui.test.mjs tests/cms-ui.test.mjs tests/compliance-ui.test.mjs tests/delivery-ui.test.mjs tests/analytics-ui.test.mjs tests/commercial-engines.test.mjs",
    "test:api": "npm --prefix backend test",
    "test:all": "npm run test && npm run test:api",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "lint:api": "npm --prefix backend run lint"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "nitro": "^3.0.260610-beta",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "concurrently": "^10.0.5",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.1.0",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
