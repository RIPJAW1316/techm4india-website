# TechM4India Root Environment Configuration
# Shared across team and deployment environments
NODE_ENV=development

# Render Production Backend & API Base URL
VITE_API_BASE_URL=https://techm4india-erp-api-l1gv.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://techm4india-erp-api-l1gv.onrender.com

# Multi-Application Port & Subdomain Architecture
PORT_MAIN=3000
PORT_HRMS=3001
PORT_FINANCE=3002
PORT_API=4000

NEXT_PUBLIC_MAIN_URL=http://localhost:3000
NEXT_PUBLIC_HRMS_URL=http://localhost:3001
NEXT_PUBLIC_FINANCE_URL=http://localhost:3002

# Production Subdomains
PROD_MAIN_URL=https://techm4india.com
PROD_HRMS_URL=https://hrms.techm4india.com
PROD_FINANCE_URL=https://finance.techm4india.com
PROD_API_URL=https://techm4india-erp-api-l1gv.onrender.com

# PostgreSQL Shared Database Configuration (Render Managed PostgreSQL)
DATABASE_URL=postgresql://techm4india_admin:YOUR_RENDER_DB_PASSWORD@dpg-cxxxxxx-a.singapore-postgres.render.com:5432/techm4india_erp?sslmode=require
