# TechM4India Frontend Local Environment Variables
# Uses the local NestJS API started with `npm run api:dev`.
NODE_ENV=development
VITE_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000

# Multi-Application Port Routing (Local Dev)
PORT_MAIN=5173
PORT_HRMS=3001
PORT_FINANCE=3002
PORT_API=4000

NEXT_PUBLIC_MAIN_URL=http://localhost:5173
NEXT_PUBLIC_HRMS_URL=http://localhost:3001
NEXT_PUBLIC_FINANCE_URL=http://localhost:3002

# Production Subdomains
PROD_MAIN_URL=https://techm4india.com
PROD_HRMS_URL=https://hrms.techm4india.com
PROD_FINANCE_URL=https://finance.techm4india.com
PROD_API_URL=https://techm4india-erp-api-l1gv.onrender.com
