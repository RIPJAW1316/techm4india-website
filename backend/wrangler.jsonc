{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "techm4india-erp-api",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "ErpApiContainer",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ERP_CONTAINER", "class_name": "ErpApiContainer" }
    ]
  },
  "exports": {
    "ErpApiContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "NODE_ENV": "production",
    "PORT": "10000",
    "ACCESS_TOKEN_TTL": "15m",
    "REFRESH_TOKEN_TTL": "30d",
    "REFRESH_COOKIE_NAME": "tm4_refresh",
    "COOKIE_SECURE": "true",
    "COOKIE_SAME_SITE": "lax",
    "TRUST_PROXY": "true",
    "BUSINESS_TIMEZONE": "Asia/Kolkata",
    "CORS_ORIGINS": "https://techm4india.com,https://www.techm4india.com"
  }
}
