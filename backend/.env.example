NODE_ENV=development
PORT=3001
# Use a local-only PostgreSQL connection here. Never commit a real credential.
DATABASE_URL=postgresql://<local-user>:<local-password>@localhost:5433/<database>?schema=public
CORS_ORIGINS=http://localhost:3000

# Generate a unique value of at least 32 random characters for each environment.
JWT_ACCESS_SECRET=<generate-a-unique-random-secret>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_COOKIE_NAME=tm4_refresh
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
TRUST_PROXY=false
BUSINESS_TIMEZONE=Asia/Kolkata

# Development seed only. Set locally; never commit a real password. Existing
# demo account passwords are preserved on later seed runs.
SEED_DEMO_PASSWORD=<set-a-development-password-locally>
DEMO_FOUNDER_PASSWORD=<set-a-development-founder-password-locally>
# Optional development Founder email (defaults to founder@techm4india.com).
DEMO_FOUNDER_EMAIL=

# One-time production Founder setup only. Existing passwords are preserved.
# Remove all three values after the account has been created; never commit a
# real password.
BOOTSTRAP_FOUNDER_ENABLED=false
BOOTSTRAP_FOUNDER_EMAIL=<production-founder-email>
BOOTSTRAP_FOUNDER_PASSWORD=<one-time-production-founder-password>
