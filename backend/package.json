{
  "name": "techm4india-erp-api",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 2 NestJS foundation for the TechM4India Company Management ERP.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "nest build",
    "render:build": "npm install --include=dev && npx prisma generate && npx nest build",
    "render:start": "npx prisma migrate deploy && node dist/src/main.js",
    "start": "prisma migrate deploy && node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "postinstall": "prisma generate",
    "lint": "eslint \"src/**/*.ts\" \"api/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "8.1.0",
    "joi": "18.2.9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.19",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "jest": "30.0.5",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript-eslint": "8.59.3"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.1"
    }
  }
}
