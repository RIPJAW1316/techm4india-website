# TechM4India Frontend Local Environment Variables
# Uses the local NestJS API started with `npm run api:dev`.
VITE_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000

# Multi-Application Port Routing (Local Dev)
NEXT_PUBLIC_MAIN_URL=http://localhost:5173
NEXT_PUBLIC_HRMS_URL=http://localhost:3003
NEXT_PUBLIC_FINANCE_URL=http://localhost:3002

# Remote Render API (available for production/integration testing)
PROD_VITE_API_BASE_URL=https://techm4india-erp-api-l1gv.onrender.com/api/v1
PROD_NEXT_PUBLIC_API_URL=https://techm4india-erp-api-l1gv.onrender.com
