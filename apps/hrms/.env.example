# TechM4India HRMS — Independent Application Environment Configuration

# Local development port (default: 3002)
PORT=3002

# Backend API proxy target (for Vite dev server)
VITE_API_TARGET=http://localhost:4000

# Explicit Backend API Base URL (if bypassing Vite proxy in staging/production)
# Development: http://localhost:4000/api/v1
# Production: https://techm4india-erp-api-l1gv.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Central Authentication & Identity Portal URL
# Development: http://localhost:3000/login
# Production: https://techm4india.com/login
VITE_CENTRAL_AUTH_URL=http://localhost:3000/login

# OIDC PKCE Client Credentials
VITE_OIDC_CLIENT_ID=hrms-app-client

# Application Hostname / Origin
# Development: http://localhost:3002
# Proposed Production: https://hrms.techm4india.com
VITE_APP_ORIGIN=http://localhost:3002
