// =========================================================================
// ACADEMIC PROGRAMS & MODULAR LMS (Domains 10 & 11)
// =========================================================================

enum ProgramCertificationType {
  TECHM4_INDUSTRY_CERTIFICATE
  UNIVERSITY_JOINT_CERTIFICATE
  GLOBAL_AFFILIATE_DIPLOMA
  AICTE_NEAT_APPROVED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonContentType {
  VIDEO
  MARKDOWN_ARTICLE
  CODE_KIT
  LAB_EXERCISE
  SLIDE_DECK
}

enum BatchStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Program {
  id                String                    @id @default(uuid())
  code              String                    @unique
  title             String
  division          DivisionCode              @default(TECHM4_ENGINEERING)
  summary           String
  durationWeeks     Int                       @default(12)
