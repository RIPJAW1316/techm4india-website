}

model Invoice {
  id                   String        @id @default(uuid())
  invoiceNumber        String        @unique
  customerId           String
  type                 InvoiceType   @default(B2B)
  status               InvoiceStatus @default(DRAFT)
  issueDate            DateTime
  dueDate              DateTime
  currency             String        @default("INR")
  exchangeRate         Decimal       @default(1.0) @db.Decimal(10, 4)
  subtotal             Decimal       @default(0.0) @db.Decimal(15, 2)
  discount             Decimal       @default(0.0) @db.Decimal(15, 2)
  taxableAmount        Decimal       @default(0.0) @db.Decimal(15, 2)
  cgst                 Decimal       @default(0.0) @db.Decimal(15, 2)
  sgst                 Decimal       @default(0.0) @db.Decimal(15, 2)
  igst                 Decimal       @default(0.0) @db.Decimal(15, 2)
  totalAmount          Decimal       @default(0.0) @db.Decimal(15, 2)
  amountPaid           Decimal       @default(0.0) @db.Decimal(15, 2)
  balanceDue           Decimal       @default(0.0) @db.Decimal(15, 2)
