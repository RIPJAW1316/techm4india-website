  sgstAmount    Decimal   @default(0.0) @db.Decimal(15, 2)
  igstAmount    Decimal   @default(0.0) @db.Decimal(15, 2)
  totalAmount   Decimal   @default(0.0) @db.Decimal(15, 2)

  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Vendor {
