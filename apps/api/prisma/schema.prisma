  quotes              Quote[]

  @@index([stage])
  @@index([vertical])
  @@index([expectedCloseDate])
  @@map("crm_deals")
}

model DealStageHistory {
  id          String    @id @default(uuid())
  dealId      String
  fromStage   DealStage
  toStage     DealStage
  notes       String?
  changedById String?
  changedAt   DateTime  @default(now())

  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("crm_deal_stage_history")
}

model Quote {
  id              String        @id @default(uuid())
  quoteNumber     String        @unique
  dealId          String?
  institutionId   String?
  subtotal        Decimal       @default(0.0) @db.Decimal(15, 2)
  discount        Decimal       @default(0.0) @db.Decimal(15, 2)
  cgstAmount      Decimal       @default(0.0) @db.Decimal(15, 2)
  sgstAmount      Decimal       @default(0.0) @db.Decimal(15, 2)
  igstAmount      Decimal       @default(0.0) @db.Decimal(15, 2)
  totalAmount     Decimal       @default(0.0) @db.Decimal(15, 2)
  status          QuoteStatus   @default(DRAFT)
  validUntil      DateTime
  notes           String?
  invoicedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  deal            Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  institution     Institution?  @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  items           QuoteItem[]

  @@index([quoteNumber])
  @@index([status])
  @@map("crm_quotes")
}

model QuoteItem {
  id            String    @id @default(uuid())
  quoteId       String
  description   String
  hsnSacCode    String    @default("998334")
  quantity      Decimal   @default(1.0) @db.Decimal(10, 2)
  unitRate      Decimal   @default(0.0) @db.Decimal(15, 2)
  taxRatePct    Decimal   @default(18.0) @db.Decimal(5, 2)
  taxableAmount Decimal   @default(0.0) @db.Decimal(15, 2)
  totalAmount   Decimal   @default(0.0) @db.Decimal(15, 2)

  quote         Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("crm_quote_items")
}

