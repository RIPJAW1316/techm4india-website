generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Core Organization / Company Model
// -------------------------------------------------------------
model Organization {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  legalName   String?
  taxId       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  departments Department[]
  branches    Branch[]
  employees   Employee[]
  holidays    Holiday[]
  accounts    Account[]

  @@map("organizations")
}

// -------------------------------------------------------------
// Shared Identity & Users Model
// -------------------------------------------------------------
model User {
  id              String    @id @default(uuid())
  organizationId  String?
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userRoles       UserRole[]
  oidcCodes       OidcAuthorizationCode[]
  appAccess       UserApplicationAccess[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  employee        Employee?
  student         Student?
  ticketsCreated  Ticket[]                @relation("TicketRequester")

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

// -------------------------------------------------------------
// Authentication Sessions & Refresh Tokens
// -------------------------------------------------------------
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  family      String    // Token family for rotation & reuse attack detection
  isRevoked   Boolean   @default(false)
  expiresAt   DateTime
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// -------------------------------------------------------------
// Role-Based Access Control (RBAC)
// -------------------------------------------------------------
model Role {
  id           String           @id @default(uuid())
  code         String           @unique
  name         String
  description  String?
  isSystemRole Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  userRoles    UserRole[]
  permissions  RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  module      String           // e.g., 'AUTH', 'USERS', 'HRMS', 'FINANCE', 'AUDIT'
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// -------------------------------------------------------------
// Central Applications & Multi-Application Access Control
// -------------------------------------------------------------
model Application {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. 'CENTRAL_DASHBOARD', 'HRMS', 'FINANCE'
  name        String
  description String?
  baseUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accessGrants UserApplicationAccess[]

  @@map("applications")
}

model UserApplicationAccess {
  id            String      @id @default(uuid())
  userId        String
  applicationId String
  isActive      Boolean     @default(true)
  grantedAt     DateTime    @default(now())
  expiresAt     DateTime?

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([userId, applicationId])
  @@index([userId])
  @@index([applicationId])
  @@map("user_application_access")
}

// -------------------------------------------------------------
// Central Audit Logging
// -------------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ======================================================}

// TECHM4INDIA HRMS DOMAIN MODELS (PHASE 4)
// Functional parity with Hr.my with Indian enterprise compliance
// ======================================================}


model Department {
  id             String        @id @default(uuid())
  organizationId String
  code           String        @unique
  name           String
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]
  designations   Designation[]
  jobPostings    JobPosting[]

  @@map("hrms_departments")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  code           String       @unique
  name           String
  city           String
  state          String
  country        String       @default("India")
  address        String?
  isHeadquarters Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]
  holidays       Holiday[]
  stockLevels    StockLevel[]
  assets         Asset[]

  @@map("hrms_branches")
}

model Designation {
  id           String      @id @default(uuid())
  code         String      @unique
  name         String
  departmentId String?
  level        Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees    Employee[]
  jobPostings  JobPosting[]
  offerLetters OfferLetter[] @relation("OfferedDesignation")

  @@map("hrms_designations")
}

model Employee {
  id                      String                     @id @default(uuid())
  userId                  String?                    @unique
  organizationId          String
  employeeNumber          String                     @unique
  firstName               String
  lastName                String
  email                   String                     @unique
  phone                   String?
  dateOfBirth             DateTime?
  gender                  String?                    // MALE, FEMALE, OTHER
  dateOfJoining           DateTime
  probationEndDate        DateTime?
  confirmationDate        DateTime?
  contractEndDate         DateTime?
  employmentType          String                     @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN
  employmentStatus        String                     @default("ACTIVE") // ACTIVE, PROBATION, NOTICE_PERIOD, TERMINATED, RESIGNED
  departmentId            String?
  designationId           String?
  branchId                String?
  managerId               String?
  panNumber               String?
  aadhaarNumber           String?
  bankAccountNumber       String?
  bankIfsc                String?
  bankName                String?
  pfUanNumber             String?
  esiNumber               String?
  address                 String?
  emergencyContactName    String?
  emergencyContactPhone   String?
  emergencyContactRelation String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  user                    User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization            Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department              Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation             Designation?               @relation(fields: [designationId], references: [id], onDelete: SetNull)
  branch                  Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manager                 Employee?                  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports           Employee[]                 @relation("EmployeeManager")
  leaveApplications       LeaveApplication[]
  leaveBalances           LeaveBalance[]
  attendanceRecords       AttendanceRecord[]
  regularizationRequests  AttendanceRegularization[]
  expenseClaims           ExpenseClaim[]
  salaryStructure         SalaryStructure?
  payslips                Payslip[]
  documents               EmployeeDocument[]
  incidentsReported       IncidentReport[]           @relation("ReportedIncidents")
  incidentsAssigned       IncidentReport[]           @relation("AssignedIncidents")
  discussionTopics        DiscussionTopic[]
  discussionReplies       DiscussionReply[]
  interviewsInterviewer   Interview[]                @relation("InterviewerEmployee")
  dealsAssigned           Deal[]                     @relation("DealOwner")
  leadsAssigned           Lead[]                     @relation("LeadOwner")
  mousSigned              MoU[]                      @relation("MouSignatory")
  batchesLed              Batch[]                    @relation("BatchFaculty")
  coursesTaught           Course[]                   @relation("CourseInstructor")
  projectsLed             Project[]                  @relation("ProjectLead")
  tasksAssigned           Task[]                     @relation("TaskAssignee")
  timesheets              Timesheet[]                @relation("EmployeeTimesheets")
  assetsAssigned          Asset[]                    @relation("AssetAssignee")
  blogPosts               CmsBlogPost[]              @relation("BlogPostAuthor")

  @@index([employeeNumber])
  @@index([email])
  @@index([departmentId])
  @@index([branchId])
  @@map("hrms_employees")
}

model LeaveType {
  id                 String             @id @default(uuid())
  organizationId     String
  code               String             @unique // ANNUAL, CASUAL, SICK, MATERNITY, PATERNITY, UNPAID
  name               String
  description        String?
  defaultDaysPerYear Float              @default(12)
  isPaid             Boolean            @default(true)
  requiresDocument   Boolean            @default(false)
  carryForwardMax    Float              @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  leaveBalances      LeaveBalance[]
  applications       LeaveApplication[]

  @@map("hrms_leave_types")
}

model LeaveBalance {
  id                 String    @id @default(uuid())
  employeeId         String
  leaveTypeId        String
  year               Int
  entitledDays       Float
  takenDays          Float     @default(0)
  pendingDays        Float     @default(0)
  carriedForwardDays Float     @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType          LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@map("hrms_leave_balances")
}

model LeaveApplication {
  id           String    @id @default(uuid())
  employeeId   String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  totalDays    Float
  isHalfDay    Boolean   @default(false)
  halfDayType  String?   // FIRST_HALF, SECOND_HALF
  reason       String
  attachmentUrl String?
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  appliedAt    DateTime  @default(now())
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("hrms_leave_applications")
}

model AttendanceRecord {
  id               String                    @id @default(uuid())
  employeeId       String
  date             DateTime                  // Midnight UTC date
  clockInTime      DateTime?
  clockOutTime     DateTime?
  clockInIp        String?
  clockOutIp       String?
  workMinutes      Int                       @default(0)
  breakMinutes     Int                       @default(0)
  overtimeMinutes  Int                       @default(0)
  status           String                    @default("PRESENT") // PRESENT, ON_LEAVE, HOLIDAY, WEEKLY_OFF, HALF_DAY, ABSENT
  isLate           Boolean                   @default(false)
  isEarlyDeparture Boolean                   @default(false)
  notes            String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  employee         Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  regularization   AttendanceRegularization?

  @@unique([employeeId, date])
  @@index([date])
  @@map("hrms_attendance_records")
}

model AttendanceRegularization {
  id                String           @id @default(uuid())
  attendanceId      String           @unique
  employeeId        String
  requestedClockIn  DateTime
  requestedClockOut DateTime
  reason            String
  status            String           @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNotes       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  attendance        AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("hrms_attendance_regularizations")
}

model ClaimCategory {
  id             String             @id @default(uuid())
  code           String             @unique
  name           String
  description    String?
  maxAmountLimit Float?
  requiresReceipt Boolean           @default(true)
  createdAt      DateTime           @default(now())

  items          ExpenseClaimItem[]

  @@map("hrms_claim_categories")
}

model ExpenseClaim {
  id                String             @id @default(uuid())
  claimNumber       String             @unique
  employeeId        String
  title             String
  totalAmount       Float
  status            String             @default("SUBMITTED") // DRAFT, SUBMITTED, APPROVED, REJECTED, PAID
  submittedAt       DateTime           @default(now())
  reviewedById      String?
  reviewedAt        DateTime?
  reimbursementDate DateTime?
  settledById       String?
  settlementBatchRef String?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items             ExpenseClaimItem[]

  @@index([employeeId])
  @@index([status])
  @@map("hrms_expense_claims")
}

model ExpenseClaimItem {
  id             String        @id @default(uuid())
  expenseClaimId String
  claimCategoryId String
  expenseDate    DateTime
  amount         Float
  merchantName   String?
  description    String
  receiptUrl     String?
  createdAt      DateTime      @default(now())

  expenseClaim   ExpenseClaim  @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  category       ClaimCategory @relation(fields: [claimCategoryId], references: [id], onDelete: Cascade)

  @@map("hrms_expense_claim_items")
}

model SalaryStructure {
  id                     String    @id @default(uuid())
  employeeId             String    @unique
  effectiveDate          DateTime  @default(now())
  monthlyCtc             Float
  basicSalary            Float
  hra                    Float
  specialAllowance       Float
  conveyanceAllowance    Float     @default(0)
  medicalAllowance       Float     @default(0)
  providentFundEmployee  Float     @default(0)
  providentFundEmployer  Float     @default(0)
  professionalTax        Float     @default(200)
  esiEmployee            Float     @default(0)
  esiEmployer            Float     @default(0)
  tdsEstimate            Float     @default(0)
  netSalary              Float
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  employee               Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("hrms_salary_structures")
}

model PayrollPeriod {
  id              String    @id @default(uuid())
  month           Int       // 1-12
  year            Int       // e.g. 2026
  status          String    @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, FINALIZED
  totalGross      Float     @default(0)
  totalDeductions Float     @default(0)
  totalNet        Float     @default(0)
  finalizedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payslips        Payslip[]

  @@unique([month, year])
  @@map("hrms_payroll_periods")
}

model Payslip {
  id                  String        @id @default(uuid())
  payrollPeriodId     String
  employeeId          String
  payslipNumber       String        @unique
  workingDays         Int           @default(30)
  paidDays            Float         @default(30)
  absentDays          Float         @default(0)
  basicSalary         Float
  hra                 Float
  allowancesTotal     Float
  grossEarnings       Float
  pfDeduction         Float
  ptDeduction         Float
  esiDeduction        Float
  taxDeduction        Float
  claimsReimbursement Float         @default(0)
  totalDeductions     Float
  netPay              Float
  isPublished         Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  payrollPeriod       PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee            Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollPeriodId, employeeId])
  @@map("hrms_payslips")
}

model CompanyDocument {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  category       String   // POLICY, FORM, HANDBOOK, TEMPLATE
  description    String?
  fileUrl        String
  fileSize       String?
  version        String   @default("1.0")
  isRestricted   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("hrms_company_documents")
}

model EmployeeDocument {
  id           String    @id @default(uuid())
  employeeId   String
  title        String
  documentType String    // RESUME, ID_PROOF, CONTRACT, CERTIFICATE, TAX_FORM
  fileUrl      String
  expiryDate   DateTime?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("hrms_employee_documents")
}

model IncidentReport {
  id              String    @id @default(uuid())
  reportNumber    String    @unique
  reporterId      String?
  isAnonymous     Boolean   @default(false)
  category        String    // SAFETY, HARASSMENT, MISCONDUCT, FACILITY, POLICY
  severity        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  title           String
  description     String
  incidentDate    DateTime
  location        String?
  status          String    @default("REPORTED") // REPORTED, UNDER_INVESTIGATION, RESOLVED, CLOSED
  assignedToId    String?
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reporter        Employee? @relation("ReportedIncidents", fields: [reporterId], references: [id], onDelete: SetNull)
  assignedTo      Employee? @relation("AssignedIncidents", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@map("hrms_incident_reports")
}

model Announcement {
  id                 String   @id @default(uuid())
  organizationId     String
  title              String
  content            String
  category           String   @default("GENERAL") // GENERAL, HOLIDAY, EVENT, POLICY, URGENT
  targetScope        String   @default("ALL") // ALL, DEPARTMENT, BRANCH
  targetDepartmentId String?
  targetBranchId     String?
  priority           String   @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  publishedAt        DateTime @default(now())
  expiresAt          DateTime?
  isPinned           Boolean  @default(false)
  authorName         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("hrms_announcements")
}

model DiscussionTopic {
  id         String            @id @default(uuid())
  title      String
  content    String
  category   String            @default("GENERAL")
  authorId   String
  isPinned   Boolean           @default(false)
  isLocked   Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  author     Employee          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies    DiscussionReply[]

  @@map("hrms_discussion_topics")
}

model DiscussionReply {
  id        String          @id @default(uuid())
  topicId   String
  authorId  String
  content   String
  createdAt DateTime        @default(now())

  topic     DiscussionTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author    Employee        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("hrms_discussion_replies")
}

model Holiday {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  date           DateTime
  isOptional     Boolean      @default(false)
  branchId       String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, date, branchId])
  @@map("hrms_holidays")
}

// -------------------------------------------------------------
// FINANCE & ACCOUNTING ERP MODULE (Section 09 Specification)
// -------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum DivisionCode {
  TECHM4_SCHOOLS
  TECHM4_ENGINEERING
  TECHM4_SOLUTIONS
  TECHM4_SPACE
  HORIZON_INSTITUTES
  GENERAL_OVERHEAD
}

enum VoucherType {
  JOURNAL
  PAYMENT
  RECEIPT
  CONTRA
  SALES_INVOICE
  PURCHASE_BILL
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum InvoiceType {
  B2B
  B2C
  B2G
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentType {
  INWARD
  OUTWARD
}

enum PaymentMethod {
  UPI
  NETBANKING
  DEBIT_CREDIT_CARD
  NEFT_RTGS
  CHEQUE
  CASH
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  REJECTED
}

enum TdsSection {
  SEC_194C
  SEC_194J_TECH
  SEC_194J_PROF
  SEC_194H
  NONE
}

model Account {
  id              String            @id @default(uuid())
  organizationId  String?
  code            String            @unique
  name            String
  type            AccountType
  category        String
  subCategory     String?
  currency        String            @default("INR")
  balance         Decimal           @default(0.0) @db.Decimal(15, 2)
  isActive        Boolean           @default(true)
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  journalLines    JournalLineItem[]
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([category])
  @@map("accounts")
}

model JournalEntry {
  id            String            @id @default(uuid())
  entryNumber   String            @unique
  date          DateTime
  voucherType   VoucherType       @default(JOURNAL)
  reference     String?
  narration     String
  status        JournalStatus     @default(DRAFT)
  division      DivisionCode      @default(GENERAL_OVERHEAD)
  totalDebit    Decimal           @default(0.0) @db.Decimal(15, 2)
  totalCredit   Decimal           @default(0.0) @db.Decimal(15, 2)
  isReversed    Boolean           @default(false)
  reversedById  String?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  lineItems     JournalLineItem[]
  invoice       Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId     String?           @unique
  expense       Expense?          @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  expenseId     String?           @unique

  @@index([entryNumber])
  @@index([date])
  @@index([status])
  @@index([division])
  @@map("journal_entries")
}

model JournalLineItem {
  id              String        @id @default(uuid())
  journalEntryId  String
  accountId       String
  debitAmount     Decimal       @default(0.0) @db.Decimal(15, 2)
  creditAmount    Decimal       @default(0.0) @db.Decimal(15, 2)
  description     String?
  division        DivisionCode?

  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_line_items")
}

model Customer {
