  isRevoked         Boolean   @default(false)
  createdAt         DateTime  @default(now())

  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program           Program   @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([certificateNumber])
  @@index([verificationToken])
  @@map("lms_certificates")
}

// =========================================================================
// STUDENTS & ADMISSIONS (Domain 12)
// =========================================================================

enum StudentFeeStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  WAIVED
}

enum GrievanceCategory {
  ACADEMIC
  LAB_EQUIPMENT
  FACULTY
  PORTAL_ACCESS
  FEES_BILLING
}

enum GrievanceStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

model Student {
  id                String                 @id @default(uuid())
  studentId         String                 @unique
  userId            String?                @unique
  institutionId     String?
  batchId           String?
  firstName         String
  lastName          String
  email             String                 @unique
  phone             String?
  gender            String?
  dob               DateTime?
  academicBranch    String                 @default("Computer Science & Engineering")
  yearOfStudy       Int                    @default(3)
  guardianName      String?
  guardianPhone     String?
  kycVerified       Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  institution       Institution?           @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  batch             Batch?                 @relation(fields: [batchId], references: [id], onDelete: SetNull)
  submissions       AssignmentSubmission[]
  certificates      Certificate[]
  fees              StudentFee[]
  grievances        StudentGrievance[]

  @@index([studentId])
  @@index([email])
  @@index([batchId])
  @@map("academic_students")
}

model StudentFee {
  id              String            @id @default(uuid())
  studentId       String
  feeType         String            @default("TUITION")
  totalAmount     Decimal           @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0.0) @db.Decimal(12, 2)
  netPayable      Decimal           @db.Decimal(12, 2)
  paidAmount      Decimal           @default(0.0) @db.Decimal(12, 2)
  balanceDue      Decimal           @db.Decimal(12, 2)
  dueDate         DateTime
  status          StudentFeeStatus  @default(UNPAID)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@map("academic_student_fees")
}

model StudentGrievance {
  id              String            @id @default(uuid())
  ticketNumber    String            @unique
  studentId       String
  category        GrievanceCategory @default(ACADEMIC)
  title           String
  description     String
  status          GrievanceStatus   @default(OPEN)
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@map("academic_student_grievances")
}

// =========================================================================
// PROJECT MANAGEMENT & ENGINEERING TIMESHEETS (Domain 13)
// =========================================================================

enum ProjectType {
  INTERNAL_RND
  CLIENT_DELIVERY
  GOVERNMENT_DEFENSE
  INSTITUTIONAL_LAB_SETUP
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskType {
  FEATURE
  BUG
  LAB_DEPLOYMENT
  DOCUMENTATION
  RESEARCH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  CODE_REVIEW
  TESTING
  DONE
}

model Project {
  id                String        @id @default(uuid())
  code              String        @unique
  name              String
  type              ProjectType   @default(INTERNAL_RND)
  institutionId     String?
  division          DivisionCode  @default(TECHM4_ENGINEERING)
  leadEmployeeId    String?
  startDate         DateTime
  targetDate        DateTime?
  budgetTotal       Decimal       @default(0.0) @db.Decimal(15, 2)
  budgetUtilized    Decimal       @default(0.0) @db.Decimal(15, 2)
  status            ProjectStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  institution       Institution?  @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  leadEmployee      Employee?     @relation("ProjectLead", fields: [leadEmployeeId], references: [id], onDelete: SetNull)
  milestones        Milestone[]
  tasks             Task[]

  @@index([code])
  @@index([status])
  @@index([division])
  @@map("pm_projects")
}

model Milestone {
  id                String    @id @default(uuid())
  projectId         String
  title             String
  dueDate           DateTime
  billingPercentage Decimal   @default(0.0) @db.Decimal(5, 2)
  isCompleted       Boolean   @default(false)
  invoiceRef        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks             Task[]

  @@index([projectId])
  @@map("pm_milestones")
}

model Task {
  id                  String      @id @default(uuid())
  projectId           String
  milestoneId         String?
  title               String
  description         String?
  taskType            TaskType    @default(FEATURE)
  assigneeEmployeeId  String?
  storyPoints         Int         @default(3)
  status              TaskStatus  @default(TODO)
  githubPrUrl         String?
  dueDate             DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone           Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assigneeEmployee    Employee?   @relation("TaskAssignee", fields: [assigneeEmployeeId], references: [id], onDelete: SetNull)
  timesheets          Timesheet[]

  @@index([projectId])
  @@index([status])
  @@map("pm_tasks")
}

model Timesheet {
  id              String    @id @default(uuid())
  taskId          String
  employeeId      String
  date            DateTime
  hoursLogged     Decimal   @db.Decimal(4, 2)
  workDescription String
  isBillable      Boolean   @default(true)
  isApproved      Boolean   @default(false)
  createdAt       DateTime  @default(now())

  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee        Employee  @relation("EmployeeTimesheets", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([date])
  @@map("pm_timesheets")
}

// =========================================================================
// PROCUREMENT & 3-WAY MATCHING (Domain 16 Expansion)
// =========================================================================

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum QualityInspectionStatus {
  ACCEPTED
  REJECTED
  PARTIALLY_ACCEPTED
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  poNumber          String              @unique
  vendorId          String
  division          DivisionCode        @default(TECHM4_SOLUTIONS)
  orderDate         DateTime            @default(now())
  deliveryDueDate   DateTime
  subtotal          Decimal             @default(0.0) @db.Decimal(15, 2)
  taxAmount         Decimal             @default(0.0) @db.Decimal(15, 2)
  totalAmount       Decimal             @default(0.0) @db.Decimal(15, 2)
  status            PurchaseOrderStatus @default(DRAFT)
  approvedById      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  vendor            Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  goodsReceiptNotes GoodsReceiptNote[]

  @@index([poNumber])
  @@index([status])
  @@map("procurement_purchase_orders")
}

model GoodsReceiptNote {
  id                String                  @id @default(uuid())
  grnNumber         String                  @unique
  purchaseOrderId   String
  receivedDate      DateTime                @default(now())
  inspectedById     String?
  qualityStatus     QualityInspectionStatus @default(ACCEPTED)
  remarks           String?
  createdAt         DateTime                @default(now())

  purchaseOrder     PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([grnNumber])
  @@map("procurement_goods_receipt_notes")
}

// =========================================================================
// INVENTORY & LAB KIT BILL OF MATERIALS (BOM) (Domain 17)
// =========================================================================

enum ItemCategory {
  ROBOTICS_PARTS
  SATELLITE_RIGS
  MICROCONTROLLERS
  CONSUMABLES
  SENSORS
  FINISHED_KIT
}

enum StockMovementType {
  PURCHASE_RECEIPT
  LAB_DISPATCH
  KIT_ASSEMBLY
  SCRAP
  RETURN
}

model InventoryItem {
  id                  String          @id @default(uuid())
  sku                 String          @unique
  name                String
  category            ItemCategory    @default(ROBOTICS_PARTS)
  uom                 String          @default("UNIT")
  hsnCode             String          @default("8471")
  reorderLevel        Int             @default(10)
  unitCost            Decimal         @default(0.0) @db.Decimal(12, 2)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  kitBomsAsComponent  KitBOM[]        @relation("KitComponentItem")
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]

  @@index([sku])
  @@index([category])
  @@map("inventory_items")
}

model KitBOM {
  id                String        @id @default(uuid())
  kitSku            String
  componentItemId   String
  quantityRequired  Int           @default(1)
  createdAt         DateTime      @default(now())

  componentItem     InventoryItem @relation("KitComponentItem", fields: [componentItemId], references: [id], onDelete: Restrict)

  @@unique([kitSku, componentItemId])
  @@map("inventory_kit_boms")
}

model StockLevel {
  id                String        @id @default(uuid())
  itemId            String
  branchId          String?
  quantityOnHand    Int           @default(0)
  quantityReserved  Int           @default(0)
  quantityAvailable Int           @default(0)
  updatedAt         DateTime      @updatedAt

  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch            Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([itemId, branchId])
  @@map("inventory_stock_levels")
}

model StockMovement {
  id            String            @id @default(uuid())
  itemId        String
  type          StockMovementType
  quantity      Int
  referenceId   String?
  notes         String?
  timestamp     DateTime          @default(now())

  item          InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([timestamp])
  @@map("inventory_stock_movements")
}

// =========================================================================
// FIXED ASSET LIFECYCLE MANAGEMENT (Domain 18)
// =========================================================================

enum AssetCategory {
  IT_LAPTOPS
  LAB_INSTRUMENTS
  THREE_D_PRINTERS
  AV_MEDIA
  FURNITURE
}

enum DepreciationMethod {
  SLM
  WDV
}

enum AssetStatus {
  IN_USE
  UNDER_MAINTENANCE
  SPARE
  DISPOSED
}

model Asset {
  id                    String              @id @default(uuid())
  assetTag              String              @unique
  name                  String
  category              AssetCategory       @default(IT_LAPTOPS)
  purchaseDate          DateTime
  purchaseCost          Decimal             @db.Decimal(15, 2)
  serialNumber          String?
  depreciationMethod    DepreciationMethod  @default(SLM)
  depreciationRatePct   Decimal             @default(15.0) @db.Decimal(5, 2)
  currentBookValue      Decimal             @db.Decimal(15, 2)
  assignedEmployeeId    String?
  branchId              String?
  status                AssetStatus         @default(IN_USE)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  assignedEmployee      Employee?           @relation("AssetAssignee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  branch                Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  maintenanceLogs       AssetMaintenance[]

  @@index([assetTag])
  @@index([category])
  @@index([status])
  @@map("assets_register")
}

model AssetMaintenance {
  id              String    @id @default(uuid())
  assetId         String
  serviceDate     DateTime
  vendorName      String
  cost            Decimal   @default(0.0) @db.Decimal(12, 2)
  description     String
  nextServiceDate DateTime?
  createdAt       DateTime  @default(now())

  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("assets_maintenance")
}

