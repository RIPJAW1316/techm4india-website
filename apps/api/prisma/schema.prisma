// =========================================================================
// HELPDESK, GRIEVANCES & SLA (Domain 21)
// =========================================================================

enum TicketCategory {
  IT_SUPPORT
  HR_QUERY
  FINANCE_QUERY
  STUDENT_GRIEVANCE
  INSTITUTION_SUPPORT
}

enum TicketPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum TicketStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

model Ticket {
  id              String          @id @default(uuid())
  ticketNumber    String          @unique
  category        TicketCategory  @default(IT_SUPPORT)
  priority        TicketPriority  @default(NORMAL)
  subject         String
  requesterUserId String?
  assignedAgentId String?
  slaDueAt        DateTime?
  resolvedAt      DateTime?
  status          TicketStatus    @default(OPEN)
  csatRating      Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  requester       User?           @relation("TicketRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  comments        TicketComment[]

  @@index([ticketNumber])
  @@index([status])
  @@index([category])
  @@map("support_tickets")
}

model TicketComment {
  id              String    @id @default(uuid())
  ticketId        String
  authorUserId    String?
  message         String
  isInternalNote  Boolean   @default(false)
  timestamp       DateTime  @default(now())

  ticket          Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_comments")
}

// =========================================================================
// STATUTORY COMPLIANCE CALENDAR (Domain 22)
// =========================================================================

enum ComplianceFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

model ComplianceObligation {
  id                String                @id @default(uuid())
  title             String
  authority         String
  frequency         ComplianceFrequency   @default(MONTHLY)
  dueDayOfMonth     Int                   @default(20)
  responsibleRoleId String?
  description       String?
  createdAt         DateTime              @default(now())

  executions        ComplianceExecution[]

  @@map("compliance_obligations")
}

model ComplianceExecution {
  id                  String                @id @default(uuid())
  obligationId        String
  periodMonth         Int
  periodYear          Int
  challanRefNumber    String?
  acknowledgementUrl  String?
  filedAt             DateTime?
  filedById           String?
  penaltyPaid         Decimal               @default(0.0) @db.Decimal(12, 2)
  createdAt           DateTime              @default(now())

  obligation          ComplianceObligation  @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@unique([obligationId, periodMonth, periodYear])
  @@map("compliance_executions")
}
