model Batch {
  id                    String        @id @default(uuid())
  batchCode             String        @unique
  programId             String
  institutionId         String?
  name                  String
  startDate             DateTime
  endDate               DateTime
  capacity              Int           @default(60)
  currentEnrolled       Int           @default(0)
