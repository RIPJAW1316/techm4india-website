enum CommunicationChannel {
  WHATSAPP_API
  EMAIL_SES
  SMS
}

model CommunicationCampaign {
  id                  String                @id @default(uuid())
  name                String
  channel             CommunicationChannel  @default(WHATSAPP_API)
  targetAudienceType  String                @default("COLLEGE_DEANS")
  sentCount           Int                   @default(0)
  deliveredCount      Int                   @default(0)
  readCount           Int                   @default(0)
  repliedCount        Int                   @default(0)
