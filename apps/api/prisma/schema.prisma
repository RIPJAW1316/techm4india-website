  @@index([email])
  @@index([institutionId])
  @@map("crm_contacts")
}

model Deal {
  id                  String             @id @default(uuid())
  dealNumber          String             @unique
  title               String
  institutionId       String?
  vertical            LeadVertical       @default(ENGINEERING_COLLEGES)
  amount              Decimal            @default(0.0) @db.Decimal(15, 2)
