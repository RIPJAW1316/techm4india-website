  @@index([slug])
  @@map("cms_pages")
}

model CmsBlogPost {
  id                  String    @id @default(uuid())
  slug                String    @unique
  title               String
  authorEmployeeId    String?
  category            String    @default("AEROSPACE_AI")
  tags                String[]
  bodyMarkdown        String
  coverImageUrl       String?
  readingTimeMinutes  Int       @default(5)
  isPublished         Boolean   @default(true)
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  author              Employee? @relation("BlogPostAuthor", fields: [authorEmployeeId], references: [id], onDelete: SetNull)

