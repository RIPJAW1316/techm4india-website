}

model Payment {
  id              String        @id @default(uuid())
  paymentNumber   String        @unique
  type            PaymentType
  method          PaymentMethod @default(NEFT_RTGS)
  amount          Decimal       @default(0.0) @db.Decimal(15, 2)
  currency        String        @default("INR")
  transactionDate DateTime      @default(now())
