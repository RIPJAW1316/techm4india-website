  expense         Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([paymentNumber])
  @@index([transactionDate])
  @@map("payments")
}

// -------------------------------------------------------------
// OIDC PKCE SSO Provider Models
// -------------------------------------------------------------
model OidcClient {
  id                      String   @id @default(uuid())
  clientId                String   @unique
  clientSecretHash        String?
  clientName              String
  redirectUris            String[]
  allowedGrantTypes       String[] @default(["authorization_code", "refresh_token"])
  allowedResponseTypes    String[] @default(["code"])
  allowedScopes           String[] @default(["openid", "profile", "email"])
  requirePkce             Boolean  @default(true)
  requireClientSecret     Boolean  @default(false)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  codes                   OidcAuthorizationCode[]

  @@map("oidc_clients")
}

model OidcAuthorizationCode {
  id                  String      @id @default(uuid())
  codeHash            String      @unique
  clientId            String
  userId              String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String      @default("S256")
  nonce               String?
  state               String?
  scope               String      @default("openid profile email")
  isUsed              Boolean     @default(false)
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime    @default(now())

  client              OidcClient  @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([codeHash])
  @@index([clientId])
  @@index([userId])
  @@map("oidc_authorization_codes")
}


// =========================================================================
// RECRUITMENT & APPLICANT TRACKING SYSTEM (ATS) (Domain 7)
// =========================================================================

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  ON_HOLD
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW_SCHEDULED
  OFFER_EXTENDED
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum OfferLetterStatus {
  ISSUED
  ACCEPTED
  DECLINED
  REVOKED
}

model JobPosting {
  id              String            @id @default(uuid())
  code            String            @unique
  title           String
  departmentId    String?
  designationId   String?
  division        DivisionCode      @default(TECHM4_SOLUTIONS)
  location        String            @default("Hyderabad HQ")
  experienceMin   Int               @default(0)
  experienceMax   Int               @default(5)
  openPositions   Int               @default(1)
  salaryMin       Decimal?          @db.Decimal(12, 2)
  salaryMax       Decimal?          @db.Decimal(12, 2)
  jobDescription  String
  status          JobPostingStatus  @default(DRAFT)
  publishedAt     DateTime?
  closingDate     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  department      Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation     Designation?      @relation(fields: [designationId], references: [id], onDelete: SetNull)
  applications    JobApplication[]

  @@index([status])
  @@index([division])
  @@map("ats_job_postings")
}

model Candidate {
  id                String            @id @default(uuid())
  firstName         String
  lastName          String
  email             String            @unique
  phone             String?
  currentCompany    String?
  currentCtc        Decimal?          @db.Decimal(12, 2)
  expectedCtc       Decimal?          @db.Decimal(12, 2)
  noticePeriodDays  Int?              @default(30)
  resumeUrl         String?
  source            String            @default("PORTAL")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  applications      JobApplication[]

  @@index([email])
  @@map("ats_candidates")
}

model JobApplication {
  id              String            @id @default(uuid())
  jobPostingId    String
  candidateId     String
  status          ApplicationStatus @default(APPLIED)
  appliedAt       DateTime          @default(now())
  stageNotes      String?
  rating          Int?              @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  jobPosting      JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  candidate       Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviews      Interview[]
  offerLetters    OfferLetter[]

  @@unique([jobPostingId, candidateId])
  @@index([status])
  @@map("ats_job_applications")
}

model Interview {
  id                    String          @id @default(uuid())
  applicationId         String
  roundName             String
  interviewerEmployeeId String?
  scheduledAt           DateTime
  durationMinutes       Int             @default(45)
  meetingUrl            String?
  score                 Int?
  feedback              String?
  status                InterviewStatus @default(SCHEDULED)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  application           JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer           Employee?       @relation("InterviewerEmployee", fields: [interviewerEmployeeId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([scheduledAt])
  @@map("ats_interviews")
}

model OfferLetter {
  id                    String            @id @default(uuid())
  applicationId         String
  offeredDesignationId  String?
  offeredCtc            Decimal           @db.Decimal(12, 2)
  joiningDate           DateTime
  validUntil            DateTime
  status                OfferLetterStatus @default(ISSUED)
  signedLetterUrl       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  application           JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  designation           Designation?      @relation("OfferedDesignation", fields: [offeredDesignationId], references: [id], onDelete: SetNull)

  @@map("ats_offer_letters")
}

