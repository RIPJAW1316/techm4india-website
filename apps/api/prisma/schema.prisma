  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  modules           CurriculumModule[]
  batches           Batch[]
  courses           Course[]
  certificates      Certificate[]

  @@index([division])
  @@index([isActive])
  @@map("academic_programs")
}

model CurriculumModule {
  id            String    @id @default(uuid())
  programId     String
  moduleNumber  Int
  title         String
  description   String?
  totalHours    Int       @default(20)
  labHours      Int       @default(12)
  theoryHours   Int       @default(8)
  createdAt     DateTime  @default(now())

  program       Program   @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, moduleNumber])
  @@map("academic_curriculum_modules")
