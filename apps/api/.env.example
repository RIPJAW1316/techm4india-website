# ==============================================================================
# TECHM4INDIA ERP — CENTRAL BACKEND CONFIGURATION
# ==============================================================================
# NOTE: Never commit real credentials, secrets, or .env files to Git.
# Copy this file to .env and configure your environment-specific values.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Server Port and Host
PORT=4000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# SHARED POSTGRESQL DATABASE CONFIGURATION (Render Managed PostgreSQL)
# ------------------------------------------------------------------------------
# Both the deployed online Render backend and local developer backends share the
# EXACT SAME PostgreSQL database instance:
#
# 1. LOCAL BACKEND (Connecting to Render Database):
#    Use the "External Database URL" from the Render Dashboard:
#    (Dashboard -> techm4india-erp-db -> Connect -> External Database URL)
#    NOTE: Render requires SSL for external connections (sslmode=require).
#
#    Example:
DATABASE_URL=postgresql://techm4india_admin:YOUR_RENDER_DB_PASSWORD@dpg-cxxxxxx-a.singapore-postgres.render.com:5432/techm4india_erp?sslmode=require
#
# 2. ONLINE RENDER BACKEND (Web Service):
#    Render automatically populates DATABASE_URL using the "Internal Database URL":
#    (e.g., postgresql://techm4india_admin:PASSWORD@dpg-cxxxxxx-a:5432/techm4india_erp)
#    This connects via Render's private virtual network with no bandwidth cost.
#
# 3. LOCAL OFFLINE / ISOLATED CONTAINER (Optional fallback):
#    DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techm4india_erp?schema=public
#
# ------------------------------------------------------------------------------
# ⚠️ SHARED DATABASE WARNING:
# When pointing your local backend to the shared Render database:
# - All local database reads and writes reflect immediately on the live database.
# - DO NOT run `npx prisma migrate reset` or destructive table drop commands.
# - Always back up the database before running migrations.
# - Use `npm run db:verify` to safely check connectivity and shared record visibility.
# ------------------------------------------------------------------------------

# API Prefix & Documentation
API_PREFIX=api/v1
SWAGGER_PATH=api/v1/docs

# Security & CORS
# Comma-separated list of allowed origins (Corporate portal, HRMS on port 3002, Finance on port 3001)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://techm4india.com,https://hrms.techm4india.com,https://finance.techm4india.com
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Authentication & Session Secrets (Phase 2 Placeholders)
# Generate with high entropy (e.g. `openssl rand -base64 32`)
JWT_SECRET=replace_with_a_secure_random_secret_in_phase_2_minimum_32_chars
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=replace_with_a_secure_refresh_secret_in_phase_2_minimum_32_chars
JWT_REFRESH_EXPIRATION=7d
