# TechM4India Central ERP Backend Configuration

# Node Environment
NODE_ENV=development

# Server Port and Host
PORT=4000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public&sslmode=prefer
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techm4india_erp?schema=public

# API Configuration
API_PREFIX=api/v1
SWAGGER_PATH=api/v1/docs

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://techm4india.com
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Future Authentication & Secrets (Placeholders for Phase 2)
# Ensure these are generated with high entropy (e.g. openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_secret_in_phase_2_minimum_32_chars
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=replace_with_a_secure_refresh_secret_in_phase_2_minimum_32_chars
JWT_REFRESH_EXPIRATION=7d
