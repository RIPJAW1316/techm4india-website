# TechM4India Central Backend Environment Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Render Managed PostgreSQL / Neon Database URL
# Syncs directly with Render production backend
DATABASE_URL=postgresql://techm4india_admin:YOUR_RENDER_DB_PASSWORD@dpg-cxxxxxx-a.singapore-postgres.render.com:5432/techm4india_erp?sslmode=require

API_PREFIX=api/v1
SWAGGER_PATH=api/v1/docs

# Allowed origins across subdomains and multi-port local application architecture
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:5173,https://techm4india.com,https://www.techm4india.com,https://hrms.techm4india.com,https://finance.techm4india.com,https://crm.techm4india.com,https://techm4india-erp-api-l1gv.onrender.com
TRUSTED_APP_URLS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,https://techm4india.com,https://hrms.techm4india.com,https://finance.techm4india.com
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

JWT_SECRET=techm4india_secure_jwt_secret_render_synced_2026_enterprise_finance
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=techm4india_secure_refresh_secret_render_synced_2026_enterprise_finance
JWT_REFRESH_EXPIRATION=7d
