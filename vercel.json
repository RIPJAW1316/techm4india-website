{
  "buildCommand": "npx vinext build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "framework": null,
  "redirects": [
    { "source": "/careers", "destination": "/contact#contact-form", "permanent": true },
    { "source": "/ecosystem", "destination": "/#ecosystem", "permanent": true },
    { "source": "/impact", "destination": "/#ecosystem", "permanent": true },
    { "source": "/programs", "destination": "/engineering", "permanent": true },
    { "source": "/research", "destination": "/solutions", "permanent": true },
    { "source": "/vision", "destination": "/about", "permanent": true },
    { "source": "/erp", "destination": "/", "permanent": false },
    { "source": "/erp/:match*", "destination": "/", "permanent": false },
    { "source": "/login", "destination": "/", "permanent": false },
    { "source": "/solutions/erp", "destination": "/solutions", "permanent": false }
  ]
}
